generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          Role      @default(OPERATIVO)
  areaId        String?
  area          Area?     @relation(fields: [areaId], references: [id])
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  tasks         Task[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  SUPERADMIN
  DIRECCION_GENERAL
  ADMIN_GENERAL
  DIRECTOR_AREA
  OPERATIVO
  AUDITOR
  VIOLENCIA_GENERO
}

model Area {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  users       User[]
  cases       Case[]
  derivationsTo   Derivation[] @relation("ToArea")
  derivationsFrom Derivation[] @relation("FromArea")
  supplies    SupplyItem[]
}

model Person {
  id              String        @id @default(cuid())
  dni             String        @unique
  firstName       String
  lastName        String
  birthDate       DateTime?
  gender          String?
  address         String?
  phone           String?
  email           String?
  familyId        String?
  family          Family?       @relation(fields: [familyId], references: [id])
  isFamilyHead    Boolean       @default(false)
  cases           Case[]
  interventions   Intervention[]
  documents       Document[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Family {
  id          String   @id @default(cuid())
  name        String?
  members     Person[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Case {
  id            String         @id @default(cuid())
  personId      String
  person        Person         @relation(fields: [personId], references: [id])
  areaId        String
  area          Area           @relation(fields: [areaId], references: [id])
  title         String
  description   String?
  status        CaseStatus     @default(ABIERTO)
  priority      Priority       @default(MEDIA)
  interventions Intervention[]
  derivations   Derivation[]
  documents     Document[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum CaseStatus {
  ABIERTO
  EN_PROCESO
  DERIVADO
  CERRADO
  PENDIENTE
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

model Intervention {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id])
  personId    String
  person      Person   @relation(fields: [personId], references: [id])
  date        DateTime @default(now())
  description String
  userId      String
  createdAt   DateTime @default(now())
}

model Derivation {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id])
  fromAreaId      String
  fromArea        Area     @relation("FromArea", fields: [fromAreaId], references: [id])
  toAreaId        String
  toArea          Area     @relation("ToArea", fields: [toAreaId], references: [id])
  reason          String
  status          DerivationStatus @default(PENDIENTE)
  observations    String?
  createdAt       DateTime @default(now())
}

enum DerivationStatus {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  COMPLETADA
}

model Provider {
  id            String   @id @default(cuid())
  name          String
  cuit          String   @unique
  address       String?
  phone         String?
  email         String?
  cbu           String?
  bank          String?
  orders        PurchaseOrder[]
  invoices      Invoice[]
}

model PurchaseOrder {
  id            String      @id @default(cuid())
  number        String      @unique
  providerId    String
  provider      Provider    @relation(fields: [providerId], references: [id])
  amount        Decimal
  description   String?
  status        OrderStatus @default(BORRADOR)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum OrderStatus {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADA
  RECHAZADA
  CUMPLIDA
  CANCELADA
}

model Invoice {
  id            String   @id @default(cuid())
  number        String
  providerId    String
  provider      Provider @relation(fields: [providerId], references: [id])
  amount        Decimal
  date          DateTime
  status        InvoiceStatus @default(PENDIENTE)
  createdAt     DateTime @default(now())
}

enum InvoiceStatus {
  PENDIENTE
  PAGADA
  ANULADA
}

model Vehicle {
  id            String   @id @default(cuid())
  plate         String   @unique
  model         String
  brand         String
  reservations  VehicleReservation[]
  fuelRecords   FuelRecord[]
}

model VehicleReservation {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  userId        String
  startDate     DateTime
  endDate       DateTime
  reason        String?
  status        ReservationStatus @default(RESERVADO)
}

enum ReservationStatus {
  RESERVADO
  EN_CURSO
  FINALIZADO
  CANCELADO
}

model FuelRecord {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  date          DateTime
  amount        Decimal
  liters        Decimal
  ticketNumber  String?
  userId        String
}

model SupplyItem {
  id            String   @id @default(cuid())
  name          String
  description   String?
  stock         Int      @default(0)
  minStock      Int      @default(0)
  areaId        String?
  area          Area?    @relation(fields: [areaId], references: [id])
  requests      SupplyRequest[]
}

model SupplyRequest {
  id            String   @id @default(cuid())
  supplyId      String
  supply        SupplyItem @relation(fields: [supplyId], references: [id])
  quantity      Int
  userId        String
  status        RequestStatus @default(PENDIENTE)
  createdAt     DateTime @default(now())
}

enum RequestStatus {
  PENDIENTE
  ENTREGADO
  RECHAZADO
}

model HRRecord {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  dni           String   @unique
  fileNumber    String?  @unique
  startDate     DateTime?
  position      String?
  status        String?
}

model Document {
  id          String   @id @default(cuid())
  name        String
  url         String
  fileType    String?
  personId    String?
  person      Person?  @relation(fields: [personId], references: [id])
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id])
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String
  read        Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus @default(PENDIENTE)
  createdAt   DateTime  @default(now())
}

enum TaskStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  entity      String
  entityId    String
  details     String?
  createdAt   DateTime @default(now())
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}
