generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          Role      @default(OPERATIVO)
  areaId        String?
  area          Area?     @relation(fields: [areaId], references: [id])
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  tasks         Task[]
  reservations  VehicleReservation[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  SUPERADMIN
  DIRECCION_GENERAL
  ADMIN_GENERAL
  DIRECTOR_AREA
  OPERATIVO
  AUDITOR
  VIOLENCIA_GENERO
}

model Area {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?  @default("blue")
  annualBudget Decimal @default(0)
  users       User[]
  cases       Case[]
  hrRecords   HRRecord[]
  derivationsTo   Derivation[] @relation("ToArea")
  derivationsFrom Derivation[] @relation("FromArea")
  supplies    SupplyItem[]
  purchaseOrders PurchaseOrder[]
  agreements  Agreement[]
}

model Person {
  id              String        @id @default(cuid())
  dni             String        @unique
  firstName       String
  lastName        String
  birthDate       DateTime?
  gender          String?
  address         String?
  latitude        Float?
  longitude       Float?
  phone           String?
  email           String?
  familyId        String?
  family          Family?       @relation(fields: [familyId], references: [id])
  isFamilyHead    Boolean       @default(false)
  cases           Case[]
  interventions   Intervention[]
  documents       Document[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([latitude, longitude])
}

model Family {
  id          String   @id @default(cuid())
  name        String?
  members     Person[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Case {
  id            String         @id @default(cuid())
  personId      String
  person        Person         @relation(fields: [personId], references: [id])
  areaId        String
  area          Area           @relation(fields: [areaId], references: [id])
  title         String
  description   String?
  status        CaseStatus     @default(ABIERTO)
  priority      Priority       @default(MEDIA)
  interventions Intervention[]
  derivations   Derivation[]
  documents     Document[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([personId])
  @@index([areaId])
  @@index([status])
}

enum CaseStatus {
  ABIERTO
  EN_PROCESO
  DERIVADO
  CERRADO
  PENDIENTE
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

model Intervention {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id])
  personId    String
  person      Person   @relation(fields: [personId], references: [id])
  date        DateTime @default(now())
  description String
  userId      String
  createdAt   DateTime @default(now())
}

model Derivation {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id])
  fromAreaId      String
  fromArea        Area     @relation("FromArea", fields: [fromAreaId], references: [id])
  toAreaId        String
  toArea          Area     @relation("ToArea", fields: [toAreaId], references: [id])
  reason          String
  status          DerivationStatus @default(PENDIENTE)
  observations    String?
  createdAt       DateTime @default(now())
}

enum DerivationStatus {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  COMPLETADA
}

model Provider {
  id            String   @id @default(cuid())
  name          String
  cuit          String   @unique
  address       String?
  phone         String?
  email         String?
  cbu           String?
  bank          String?
  orders        PurchaseOrder[]
  invoices      Invoice[]
}

model PurchaseOrder {
  id            String      @id @default(cuid())
  number        String      @unique
  providerId    String?
  provider      Provider?   @relation(fields: [providerId], references: [id])
  providerName  String?
  providerCuit  String?
  providerNumber String?
  areaId        String?
  area          Area?       @relation(fields: [areaId], references: [id])
  amount        Decimal
  description   String?
  status        OrderStatus @default(BORRADOR)

  // Nuevos campos para OCR y cumplimiento
  expediente    String?
  deliveryDate  DateTime?
  deliveryPlace String?
  paymentTerms  String?
  items         PurchaseOrderItem[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  orderId         String
  order           PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quantity        Decimal
  unitOfMeasure   String?
  description     String
  unitPrice       Decimal
  totalPrice      Decimal
  fulfilledQuantity Decimal    @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum OrderStatus {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADA
  RECHAZADA
  CUMPLIDA
  CANCELADA
}

model Agreement {
  id            String          @id @default(cuid())
  number        String?         @unique
  title         String
  description   String?
  parties       String?         // Partes intervinientes
  amount        Decimal?        @default(0)
  startDate     DateTime?
  endDate       DateTime?
  status        AgreementStatus @default(VIGENTE)
  areaId        String?
  area          Area?           @relation(fields: [areaId], references: [id])
  fileUrl       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum AgreementStatus {
  EN_REVISION
  VIGENTE
  VENCIDO
  RESCINDIDO
  FINALIZADO
}

model Invoice {
  id            String   @id @default(cuid())
  number        String
  providerId    String
  provider      Provider @relation(fields: [providerId], references: [id])
  amount        Decimal
  date          DateTime
  status        InvoiceStatus @default(PENDIENTE)
  createdAt     DateTime @default(now())
}

enum InvoiceStatus {
  PENDIENTE
  PAGADA
  ANULADA
}

model Vehicle {
  id            String   @id @default(cuid())
  plate         String   @unique
  model         String
  brand         String
  fuelCardNumber String?
  fuelMonthlyLimit Decimal? @default(0)
  status        VehicleStatus @default(DISPONIBLE)
  vtvExpiry     DateTime?
  insuranceExpiry DateTime?
  lastServiceKm Int?     @default(0)
  reservations  VehicleReservation[]
  fuelRecords   FuelRecord[]
}

enum VehicleStatus {
  DISPONIBLE
  EN_TALLER
  FUERA_DE_SERVICIO
}

model VehicleReservation {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  areaId        String?
  startDate     DateTime
  endDate       DateTime
  reason        String?
  status        ReservationStatus @default(PENDIENTE)
  observations  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([startDate, endDate, status])
}

enum ReservationStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
  EN_CURSO
  FINALIZADA
  CANCELADA
}

model FuelRecord {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  date          DateTime
  amount        Decimal
  liters        Decimal
  ticketNumber  String?
  userId        String
}

model SupplyItem {
  id            String   @id @default(cuid())
  name          String
  description   String?
  stock         Int      @default(0)
  minStock      Int      @default(0)
  areaId        String?
  area          Area?    @relation(fields: [areaId], references: [id])
  requests      SupplyRequest[]
}

model SupplyRequest {
  id            String   @id @default(cuid())
  supplyId      String
  supply        SupplyItem @relation(fields: [supplyId], references: [id])
  quantity      Int
  userId        String
  status        RequestStatus @default(PENDIENTE)
  createdAt     DateTime @default(now())
}

enum RequestStatus {
  PENDIENTE
  ENTREGADO
  RECHAZADO
}

enum HRStatus {
  ACTIVO
  LICENCIA
  VACACIONES
  BAJA
}

enum ContractType {
  MONOTRIBUTISTA
  MENSUALIZADO
  PLANTA_PERMANENTE
}

model HRRecord {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  dni           String   @unique
  fileNumber    String?  @unique
  startDate     DateTime?
  position      String?
  areaId        String?
  area          Area?    @relation(fields: [areaId], references: [id])
  status        HRStatus @default(ACTIVO)
  statusUntil   DateTime?
  contractType  ContractType @default(MENSUALIZADO)
  category      Int?
  salary        Decimal? @default(0)
  schedule      String?
  imageUrl      String?
  tasks         String?  @db.Text
  createdAt     DateTime @default(now())
}

model Document {
  id          String   @id @default(cuid())
  name        String
  url         String
  fileType    String?
  personId    String?
  person      Person?  @relation(fields: [personId], references: [id])
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id])
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String
  read        Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus @default(PENDIENTE)
  viewerIds   String?   // Comma-separated list of User IDs allowed to view this task/event
  createdAt   DateTime  @default(now())
}

enum TaskStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  entity      String
  entityId    String
  details     String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([entity, entityId])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Shelter {
  id               String   @id @default(cuid())
  name             String
  address          String
  coordinator      String
  capacity         Int      @default(50)
  occupied         Int      @default(0)
  rationsDelivered Int      @default(0)
  status           String   @default("HABILITADO")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model PadronUnificado {
  dni                   String   @id
  nombre_completo       String?
  cantidad_programas    Int      @default(0)
  programas_activos     String?  @db.Text
  roles                 String?  @db.Text
  dnis_familiares       String?  @db.Text
  nombres_familiares    String?  @db.Text
  localidad             String?
  barrio                String?
  direccion             String?
  telefono              String?
  email                 String?
  fecha_nacimiento      String?
  edad_aprox            String?
  genero                String?
  latitude              Float?
  longitude             Float?
  prog_centro_de_familia                                         Int @default(0)
  prog_tarjeta_alimentar                                         Int @default(0)
  prog_jardines_municipales                                      Int @default(0)
  prog_colonias_municipales_2026                                 Int @default(0)
  prog_colonias_barrios_populares_2026                           Int @default(0)
  prog_centro_de_formacion_profesional_3f                        Int @default(0)
  prog_intervenciones_desarrollo_humano                          Int @default(0)
  prog_prestaciones_desarrollo_humano                            Int @default(0)
  prog_tarjeta_mas_familia                                       Int @default(0)
  prog_escuelas_municipales_emac_emmu_capacyt                    Int @default(0)
  prog_espacios_de_educacion_no_formal_udis_apoyos_becas_envion   Int @default(0)
  prog_curso_de_arbitros_deportes                                Int @default(0)
  prog_gimnasio_municipal_deportes                               Int @default(0)
  prog_natacion_municipal_deportes                               Int @default(0)
  prog_servicios_locales_de_ninez_caseros_el_libertador_derqui   Int @default(0)
  prog_programa_envion_edla_evita_el_libertador                  Int @default(0)
  prog_comedores_comunitarios_programa_fosc                      Int @default(0)

  @@map("padron_unificado")
}

model ParticipacionPrograma {
  id                 BigInt   @id @default(autoincrement())
  dni                String
  nombre_completo    String?
  programa           String
  roles              String?
  cantidad_registros Int      @default(1)
  detalle_destacado  String?  @db.Text
  telefono           String?
  email              String?
  direccion          String?
  localidad          String?
  barrio             String?

  @@map("participaciones_programas")
}
